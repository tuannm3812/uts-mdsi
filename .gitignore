# Raw course files copied from Google Drive for local LLM indexing.
# Keep them in the repo working tree, but do not commit large binaries by default.
llm-wiki/02-subjects/**/lectures/raw/
llm-wiki/02-subjects/**/assignments/raw/
llm-wiki/02-subjects/**/notebooks/raw/
llm-wiki/02-subjects/**/sources/raw/

# Locally extracted assessment corpora; keep the reproducible setup and source
# archive location in notes, but do not commit third-party submission documents.
llm-wiki/02-subjects/**/assignments/current-*/**/data/

# Fetched source data for exploratory (private, non-reproducibility-pipeline)
# notebooks -- regenerable via the fetch_*.py scripts in the same folder, and
# includes a 100MB+ geojson that shouldn't go into git. Distinct from
# notebooks/raw/ above, which is for imported course files.
llm-wiki/02-subjects/**/notebooks/active-fire-datascience/data/

# Local OS metadata.
.DS_Store
__MACOSX/

# Obsidian local UI state; keep vault settings, not per-machine workspace state.
llm-wiki/.obsidian/workspace*.json
llm-wiki/.obsidian/cache

# Scratch/build output — regenerable, not source. Keep locally, don't commit.
/output/
/tmp/
.pytest_cache/
__pycache__/
*.pyc
